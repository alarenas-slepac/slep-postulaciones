[Unit]
Description=SGA WhatsApp bridge (single linked device)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=slepac
Group=slepac
WorkingDirectory=/home/slepac/apps/slep_postulaciones/services/whatsapp
# Node instalado con nvm en la cuenta; confirmar acceso a esta ruta con el proveedor.
# Al actualizar Node, adaptar ExecStart antes de retirar la version anterior.
ExecStart=/home/slepac/.nvm/versions/node/v22.23.3/bin/node --env-file=/home/slepac/.config/sga-whatsapp/service.env src/index.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/slepac/.local/share/sga-whatsapp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
